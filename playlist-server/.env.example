# Copy to .env next to docker-compose.yml
# Base playlists — add as many as you want, comma-separated:
PLAYLISTS="Home TV|http://192.168.100.118:8409/iptv/channels.m3u,Provider B|https://example.com/playlist-b.m3u8"
# XMLTV guide passthrough (served at /epg.xml on the playlist server):
EPG_URL=http://192.168.100.118:8409/iptv/xmltv.xml
CACHE_TTL=900
USER_AGENT=IPTV-Tizen/1.0
# Set a secret to enable runtime add/remove of playlists via /admin/sources
ADMIN_TOKEN=***
