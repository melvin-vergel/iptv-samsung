# Copy to .env and adjust. NEVER commit .env (it holds the cert password).

# --- Signing certificate (created once, reused from ./cert/) ---
CERT_ALIAS=IPTVDeveloper
CERT_COUNTRY=NL
CERT_NAME=IPTV
CERT_PASSWORD=change-me-please

# --- Target TV ---
# IP of the TV on your LAN. Also enter the IP of THIS machine
# (the Docker host) in the TV's Developer Mode dialog.
TIZEN_TV_IP=192.168.1.100

# --- App ---
APP_ID=IPTVa1b2c3.IPTV
WGT_NAME=IPTV.wgt

# --- Installer internals ---
DOCKER_IMAGE_NAME=iptv-tizen-installer
TIZEN_STUDIO_VERSION=5.6
